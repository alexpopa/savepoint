IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
AUTH_EMAIL_MODE=console

# Optional: enables Steam account linking and library refreshes. Never expose this key to the browser.
STEAM_API_KEY=

# Optional: enables Xbox account linking through Microsoft sign-in. XBOX_TOKEN_KEY is 32 random bytes in base64
# (for example `openssl rand -base64 32`) and encrypts stored Microsoft sign-ins. Never expose these to the browser.
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
XBOX_TOKEN_KEY=

# Optional: enables PlayStation linking with a pasted NPSSO token. PSN_TOKEN_KEY is 32 random bytes in base64
# (for example `openssl rand -base64 32`) and encrypts stored Sony sign-ins. Never expose it to the browser.
PSN_TOKEN_KEY=

# Optional: enables RetroAchievements linking and refreshes. The Web API key of the RGBoner RetroAchievements account.
# Never expose it to the browser.
RA_API_KEY=
